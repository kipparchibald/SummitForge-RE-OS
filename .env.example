# Voxli.dev RE OS Environment
# Copy to .env.local for local dev. Never commit real secrets.

NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token
# Prefer xAI Grok; OpenAI also works
XAI_API_KEY=
OPENAI_API_KEY=

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# DEMO / Preview — true unlocks demo banner + open middleware
# PRODUCTION deploy: set false (or omit → defaults false)
NEXT_PUBLIC_DEMO_MODE=true

# Sprint 0 brand first-paint (Archibald-Bagley example)
NEXT_PUBLIC_COMPANY_NAME=Archibald-Bagley Real Estate
NEXT_PUBLIC_BRAND_TAGLINE=Your Eastern Idaho Realtors
NEXT_PUBLIC_BRAND_PHONE=(208) 745-5911
NEXT_PUBLIC_BRAND_DOMAIN=archibaldbagley.com
NEXT_PUBLIC_BRAND_PRIMARY=#1e3a5f
NEXT_PUBLIC_BRAND_SECONDARY=#2d5a87
NEXT_PUBLIC_BRAND_ACCENT=#c4a35a
# NEXT_PUBLIC_BRAND_LOGO=https://…

# Monetization (Sprint 5)
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Preferred listings source — brokerage already holds licensed Navica credentials.
# SummitForge pulls public IDX from this endpoint (no MLS login / MFA / kick-outs).
ARCHIBALD_LISTINGS_URL=https://www.archibaldbagley.com/api/listings/live

# Direct Navica / Snake River MLS (optional fallback if brokerage API is down)
NAVICA_IDX_URL=
NAVICA_API_KEY=

# Form Simplicity
# NEXT_PUBLIC_FORM_SIMPLICITY_URL=https://www.formsimplicity.com/
# FORM_SIMPLICITY_API_KEY=
# NEXT_PUBLIC_APP_URL=https://voxli.dev

# Vercel Cron
CRON_SECRET=

# Land deal digest (optional)
# RESEND_API_KEY=
# DIGEST_FROM=deals@yourdomain.com
# DIGEST_TO=you@yourdomain.com

# Twilio SMS (Sprint 3)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+12085551234

# Fail build on production foundation gaps (optional CI)
# VOXLI_STRICT_ENV=true
